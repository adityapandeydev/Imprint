# Server Environment 
APP_ENV=development
APP_PORT=8080

# Database Configuration 
DATABASE_URL=postgres://user:password@ep-project.aws.neon.tech/imprint?sslmode=require

# External Book Providers
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
GOOGLE_BOOKS_API_KEY= # Optional: Free API key from Google Cloud Console (APIs & Services > Credentials)

# HTTP Client Timeouts
PROVIDER_TIMEOUT_SECONDS=5

# Logging (debug, info, warn, error)
LOG_LEVEL=info
