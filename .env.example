# ==============================================================================
# Imprint Environment Configuration
# ==============================================================================

# Server Environment (development, test, production)
APP_ENV=development
APP_PORT=8080

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
# Example Neon URL: postgres://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Local URL: postgres://postgres:postgres@localhost:5432/imprint?sslmode=disable
DATABASE_URL=postgres://user:password@ep-project.aws.neon.tech/imprint?sslmode=require

# External Book Providers
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1

# HTTP Client Timeouts (seconds)
PROVIDER_TIMEOUT_SECONDS=5

# Logging (debug, info, warn, error)
LOG_LEVEL=info
